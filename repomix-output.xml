          </div>

          <div className="modal-actions">
            <button
              type="button"
              className="secondary-btn"
              onClick={closeWasteModal}
            >
              Cancelar
            </button>

            <button
              type="submit"
              className="primary-btn"
            >
              Registrar Merma
            </button>
          </div>
        </form>
      </Modal>
    </>
  );
}

export default Inventory;
