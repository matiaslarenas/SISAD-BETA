<file path="src/utils/recipeCalculator.js">
function normalizeUnitToken(unit) {
    if (unit == null) {
        return "";
    }

    const normalized = String(unit).trim().toLowerCase();
    if (!normalized) {
        return "";
    }

    const asPlural = normalized.endsWith("s") ? normalized.slice(0, -1) : normalized;

    switch (asPlural) {
        case "g":
        case "gramo":
        case "gramos":
            return "gr";
        case "kg":
        case "kilo":
        case "kilos":
            return "kg";
        case "l":
        case "litro":
        case "litros":
            return "lt";
        case "ml":
        case "mililitro":
        case "mililitros":
            return "ml";
        case "u":
        case "un":
        case "unidad":
        case "unidades":
            return "un";
        default:
            return normalized;
    }
}

export function normalizeQuantity(
    quantity,
    recipeUnit,
    inventoryUnit,
    avgUnitWeightGr
) {
    const value = Number(quantity);
    if (!Number.isFinite(value)) {
        return 0;
    }

    const normalizedRecipeUnit = normalizeUnitToken(recipeUnit);
    const normalizedInventoryUnit = normalizeUnitToken(inventoryUnit);

    if (!normalizedRecipeUnit || !normalizedInventoryUnit) {
        return value;
    }

    if (normalizedRecipeUnit === normalizedInventoryUnit) {
        return value;
    }

    if (
        normalizedRecipeUnit === "gr" &&
        normalizedInventoryUnit === "kg"
    ) {
        return value / 1000;
    }

    if (
        normalizedRecipeUnit === "kg" &&
        normalizedInventoryUnit === "gr"
    ) {
        return value * 1000;
    }

    if (
        normalizedRecipeUnit === "ml" &&
        normalizedInventoryUnit === "lt"
    ) {
        return value / 1000;
    }

    if (
        normalizedRecipeUnit === "lt" &&
        normalizedInventoryUnit === "ml"
    ) {
        return value * 1000;
    }

    // Recipes sometimes express a "piece" ingredient in grams
    // (e.g. "50 gr de pimentón") while the product is purchased
    // per unit ("un"). Without an average weight per unit, this
    // combination would silently multiply cost by raw grams
    // instead of converting to a fraction of a unit.
    if (
        normalizedRecipeUnit === "gr" &&
        normalizedInventoryUnit === "un"
    ) {
        if (avgUnitWeightGr && avgUnitWeightGr > 0) {
            return value / avgUnitWeightGr;
        }
        return value;
    }

    if (
        normalizedRecipeUnit === "un" &&
        normalizedInventoryUnit === "gr"
    ) {
        if (avgUnitWeightGr && avgUnitWeightGr > 0) {
            return value * avgUnitWeightGr;
        }
        return value;
    }

    if (
        normalizedRecipeUnit === "kg" &&
        normalizedInventoryUnit === "un"
    ) {
        if (avgUnitWeightGr && avgUnitWeightGr > 0) {
            return (value * 1000) / avgUnitWeightGr;
        }
        return value;
    }

    if (
        normalizedRecipeUnit === "un" &&
        normalizedInventoryUnit === "kg"
    ) {
        if (avgUnitWeightGr && avgUnitWeightGr > 0) {
            return (value * avgUnitWeightGr) / 1000;
        }
        return value;
    }

    return value;
}

/**
 * Recursively resolves a recipe's ingredients down to raw inventory
 * products, expanding any sub-recipe ("base_recipe") references into
 * their own ingredients scaled by yield. `multiplier` represents how
 * many times the recipe is being produced (e.g. how many portions
 * sold), and is threaded through recursive calls so nested
 * sub-recipes scale correctly.
 *
 * A base recipe with no ingredients yet (e.g. status
 * "pending_measurement") or a missing/unresolvable reference simply
 * contributes nothing, keeping costing conservative instead of
 * guessing at unmeasured quantities.
 */
export function flattenRecipeIngredients(
    recipe,
    allRecipes = [],
    multiplier = 1,
    visitedRecipeIds = new Set()
) {
    if (!recipe?.ingredients?.length) {
        return [];
    }

    if (visitedRecipeIds.has(recipe.id)) {
        // Circular sub-recipe reference guard.
        return [];
    }

    const nextVisited = new Set(visitedRecipeIds);
    nextVisited.add(recipe.id);

    const flattened = [];

    for (const ingredient of recipe.ingredients) {
        if (ingredient.baseRecipeId) {
            const baseRecipe = allRecipes.find(
                (r) => r.id === ingredient.baseRecipeId
            );

            if (!baseRecipe?.yieldQuantity) {
                continue;
            }

            const nestedMultiplier =
                (ingredient.quantity / baseRecipe.yieldQuantity) *
                multiplier;

            flattened.push(
                ...flattenRecipeIngredients(
                    baseRecipe,
                    allRecipes,
                    nestedMultiplier,
                    nextVisited
                )
            );
        } else if (ingredient.productId) {
            flattened.push({
                productId: ingredient.productId,
                quantity: ingredient.quantity * multiplier,
                unit: ingredient.unit,
            });
        }
    }

    return flattened;
}

export function calculateRecipeMaxPortions(
    recipe,
    inventory,
    allRecipes = []
) {
    const flattened = flattenRecipeIngredients(
        recipe,
        allRecipes
    );

    if (flattened.length === 0) {
        return 0;
    }

    const aggregated = new Map();

    for (const ingredient of flattened) {
        const existing = aggregated.get(ingredient.productId);
        if (existing) {
            existing.quantity += ingredient.quantity;
        } else {
            aggregated.set(ingredient.productId, {
                quantity: ingredient.quantity,
                unit: ingredient.unit,
            });
        }
    }

    let maxPortions = Infinity;

    for (const [productId, { quantity, unit }] of aggregated) {
        const product = inventory.find(
            (item) => item.id === productId
        );

        if (!product || product.onHand <= 0) {
            return 0;
        }

        const normalizedQty = normalizeQuantity(
            quantity,
            unit,
            product.purchaseUnit,
            product.avgUnitWeightGr
        );

        if (normalizedQty > 0) {
            const portionsForIngredient = Math.floor(
                product.onHand / normalizedQty
            );
            if (portionsForIngredient < maxPortions) {
                maxPortions = portionsForIngredient;
            }
        }
    }

    return maxPortions === Infinity ? 0 : Math.max(0, maxPortions);
}

export function calculateRecipeCost(
    recipe,
    inventory,
    allRecipes = []
) {
    const flattened = flattenRecipeIngredients(
        recipe,
        allRecipes
    );

    return flattened.reduce(
        (total, ingredient) => {
            const product = inventory.find(
                (item) =>
                    item.id === ingredient.productId
            );

            if (!product) {
                return total;
            }

            const normalizedQuantity =
                normalizeQuantity(
                    ingredient.quantity,
                    ingredient.unit,
                    product.purchaseUnit,
                    product.avgUnitWeightGr
                );

            return (
                total +
                product.costPerUnit *
                normalizedQuantity
            );
        },
        0
    );
}

/**
 * Cost of a single yield unit of a base recipe (e.g. cost per "masa"
 * out of a batch that yields 4). Returns 0 when the base recipe has
 * no yield defined yet (e.g. status "pending_measurement").
 */
export function calculateBaseRecipeUnitCost(
    baseRecipe,
    inventory,
    allRecipes = []
) {
    if (!baseRecipe?.yieldQuantity) {
        return 0;
    }

    const batchCost = calculateRecipeCost(
        baseRecipe,
        inventory,
        allRecipes
    );

    return batchCost / baseRecipe.yieldQuantity;
}

export function calculateMargin(
    recipeCost,
    salePrice
) {
    if (!salePrice) {
        return 0;
    }

    return (
        ((salePrice - recipeCost) /
            salePrice) *
        100
    );
}

export function calculateProfit(
    recipeCost,
    salePrice
) {
    return (
        salePrice - recipeCost
    );
}

export function formatCurrency(
    value
) {
    return new Intl.NumberFormat(
        "es-CL",
        {
            style: "currency",
            currency: "CLP",
            minimumFractionDigits: 0,
        }
    ).format(value);
}
