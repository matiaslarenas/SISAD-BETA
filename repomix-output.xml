.inventory-quick-search input {
  width: 100%;
  min-height: 42px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font: inherit;
}

.inventory-result-count,
.table-pagination {
  color: var(--muted);
  font-size: 0.85rem;
}

.table-empty-state {
  padding: 28px 12px;
  text-align: center;
  color: var(--muted);
}

.table-pagination {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
  margin-top: 16px;
}

.restock-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  border: 1px solid rgba(29, 105, 81, 0.2);
  border-radius: 9px;
  padding: 7px 10px;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 0.8rem;
  font-weight: 700;
}

.restock-btn:hover {
  color: white;
  background: var(--primary);
}

.restock-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px rgba(29, 105, 81, 0.18);
}

.not-applicable {
  color: var(--muted);
}

.financial-summary-item {
  margin-bottom: 10px;
}

.restore-summary {
  display: grid;
  gap: 16px;
}

.restore-metadata {
  margin: 4px 0 8px;
  color: var(--muted);
  font-size: 0.85rem;
}

.restore-content-list {
  margin: 8px 0 0 16px;
  padding: 0;
  color: var(--text);
  font-size: 0.88rem;
}

.restore-warning {
  font-size: 0.88rem;
}

.restore-actions {
  justify-content: flex-end;
}

@media (max-width: 980px) {

