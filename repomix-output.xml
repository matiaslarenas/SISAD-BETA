export function createPurchaseOrder(
  state,
  values
) {
  const purchase = normalizePurchase(
    {
      ...values,
      id:
        values.id?.trim() ||
        `OC-${String(
          state.purchases.length + 1001
        )}`,
    },
    state.inventoryCatalog
  );

  return {
    ...state,
